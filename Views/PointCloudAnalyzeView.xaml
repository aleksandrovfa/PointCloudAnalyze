<Window x:Class="PointCloudAnalyze.Views.PointCloudAnalyzeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PointCloudAnalyze.Views"
        xmlns:viewmodels="clr-namespace:PointCloudAnalyze.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:PointCloudAnalyzeViewModel}"
        mc:Ignorable="d"
        Height="360"
        Width="280"
        ResizeMode="NoResize"
        Title="Перекрытие к облаку">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0"
                  Margin="5">
            <GroupBox.Header>
                <CheckBox IsChecked="{Binding InsideCreate}"
                          Content="Расставить внутренние точки" />
            </GroupBox.Header>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Text="Шаг сетки:"
                           Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Grid.Row="0"
                         Margin="5"
                         Text="{Binding InsideStep}" />
                <TextBlock Grid.Column="2"
                           Grid.Row="0"
                           Text="мм."
                           Margin="5"
                           VerticalAlignment="Center" />
                <CheckBox  Grid.Column="0"
                           Grid.Row="1"
                           Margin="5"
                           IsChecked="{Binding InsideExactly}"
                           Content="Точно соблюдать шаг" />
                <TextBlock Grid.Column="0"
                           Grid.Row="2"
                           Text="Кол-во точек в ячейке:"
                           Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Grid.Row="2"
                         Margin="5"
                         Text="{Binding InsidePointCount}"/>
                <TextBlock Grid.Column="2"
                           Grid.Row="2"
                           Text="шт."
                           Margin="5"
                           VerticalAlignment="Center" />
                
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Grid.Row="3"
                           Text="Выбор используемой точки из ячейки:"
                           Margin="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Value="{Binding InsidePointLocation}"
                        Grid.Row="4"
                        Margin="20 5 20 5"
                        Maximum="2"
                        Ticks="0,1,2"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True" />
                <DockPanel Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Grid.Row="5"
                           Margin="5">
                    <TextBlock Text="Нижняя"
                               DockPanel.Dock="Left"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="Верхняя"
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Средняя" 
                               HorizontalAlignment="Center"/>
                </DockPanel>
                           


            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1"
                  Margin="5">
            <GroupBox.Header>
                <CheckBox Content="Редактировать границу плиты"
                          IsChecked="{Binding BorderCreate}" />
            </GroupBox.Header>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition  Height="Auto " />
                    <RowDefinition  Height="Auto " />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Text="Размер ячейки:"
                           Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Grid.Row="0"
                         Margin="5"
                         Text="{Binding BorderSizeBox}" />
                <TextBlock Grid.Column="2"
                           Grid.Row="0"
                           Text="мм."
                           Margin="5"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="0"
                           Grid.Row="1"
                           Text="Кол-во точек в ячейке:"
                           Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Grid.Row="1"
                         Margin="5"
                         Text="{Binding BorderPointCount}" />
                <TextBlock Grid.Column="2"
                           Grid.Row="1"
                           Text="шт."
                           Margin="5"
                           VerticalAlignment="Center" />
            </Grid>
        </GroupBox>
        <Button Grid.Row="2"
                Margin="5"
                Content="Старт"
                Command="{Binding StartCommand}" />


    </Grid>
</Window>
